<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unitree_l2_lidar</name>
  <version>0.0.0</version>
  <description>
    Launch + config wrapper for the Unitree L2 LiDAR. Delegates to the
    upstream unitree_lidar_ros2 driver (vendored under
    warrior_perception/unilidar_sdk2/).
  </description>
  <maintainer email="lord.daniel.w@hotmail.com">fire</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>unitree_lidar_ros2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
