<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omnivision</name>
  <version>0.0.0</version>
  <description>
    360-degree camera and LiDAR fusion. Projects LiDAR points onto an
    equirectangular image to publish textured point clouds, depth maps,
    image overlays, and mask-filtered obstacle clouds. Includes a yaw
    calibration GUI / OpenCV trackbar tool / dynamic parameter server.
  </description>
  <maintainer email="lord.daniel.w@hotmail.com">fire</maintainer>
  <license>GPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
