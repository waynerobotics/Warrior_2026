<?xml version="1.0"?>
<launch>
  <!-- 生成 robot_description -->
  <let name="urdf_path"
       value="$(find-pkg-share warrior_description)/xacro/warrior.xacro"/>

  <!-- robot_state_publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
  </node>

  <!-- joint_state_publisher -->
  <node pkg="joint_state_publisher" exec="joint_state_publisher" output="screen">
    <param name="use_gui" value="false"/>
  </node>

  <!-- ros2_control_node -->
  <node pkg="controller_manager" exec="ros2_control_node" output="screen">
    <param from="$(find-pkg-share warrior_control)/config/warrior_controllers.yaml"/>
  </node>

  <!-- controller spawners -->
  <node pkg="controller_manager" exec="spawner" output="screen" args="joint_state_broadcaster"/>
  <node pkg="controller_manager" exec="spawner" output="screen" args="diff_drive_controller"/>

  <!-- RViz2 -->
  <node pkg="rviz2" exec="rviz2" output="screen">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
  </node>
</launch>
  