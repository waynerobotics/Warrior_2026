<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:property name="slewing_plate_mass" value="20.0"/>
    <xacro:property name="steer_assembly_mass" value="0.7"/>

    <xacro:property name="steer_assembly_color" value="metal_gray"/>
    <xacro:property name="slewing_plate_color" value="medium_gray"/>
    <xacro:property name="drive_wheel_color" value="black"/>

    <xacro:property name="steer_offset_to_plate" value="0.03175 0 0.077866"/>
    <xacro:property name="drive_offset_to_steer" value="0.000847 -0.006293 -0.248866"/>
    <xacro:property name="drive_rpy" value="0 0 0"/>
    <xacro:property name="drive_axis" value="0 1 0"/>

    <!-- ========== Inertia Macros ========== -->
    <xacro:macro name="wheel_inertia" params="mass">
        <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="0.01" ixy="0" ixz="0" 
                iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </xacro:macro>

</robot>