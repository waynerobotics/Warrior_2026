<?xml version="1.0"?>
<robot name="warrior_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find warrior_description)/xacro/material.xacro"/>
  <xacro:include filename="$(find warrior_description)/xacro/swerve_module/swerve_module.xacro"/>
  <!-- ========== Properties ========== -->

  <xacro:property name="angle_offset" value="${pi/6}"/>

   <xacro:property name="front_plate_offset" value="0.838 0.003 -0.349"/>
   <xacro:property name="left_plate_offset" value="0.025 0.47 -0.349"/>
   <xacro:property name="right_plate_offset" value="0.024 -0.468 -0.349"/>

  <!-- Wheel properties -->
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_offset_z" value="-0.15"/>
  <xacro:property name="wheel_radius" value="0.1"/>

  <!-- Base properties -->
  <xacro:property name="base_mass" value="5.0"/>
  <xacro:property name="base_footprint_height" value="${0.508 + wheel_radius}"/>
  
  <!-- Module positions -->
  <xacro:property name="left_y" value="0.465"/>
  <xacro:property name="right_y" value="-0.465"/>
  <xacro:property name="left_x" value="0.03" />
  <xacro:property name="right_x" value="0.03" />
  <xacro:property name="front_x" value="0.845"/>

  <!-- Camera -->
  <xacro:property name="camera_offset_z" value="-0.09"/>
  
  <!-- Initial orientations (radians) -->
  <!-- <xacro:property name="left_initial_angle" value="-1.0472"/> -->   <!-- -60° -->
  <!-- <xacro:property name="right_initial_angle" value="-2.0944"/> -->  <!-- -120° -->
  <!-- <xacro:property name="front_initial_angle" value="-1.5708"/> -->  <!-- -90° -->

  <xacro:property name="left_initial_angle" value="0"/>   <!-- -90° -->
  <xacro:property name="right_initial_angle" value="0"/>  <!-- -90° -->
  <xacro:property name="front_initial_angle" value="0"/>  <!-- -90° -->

  
  <!-- Sensor properties -->
  <xacro:property name="pole_height" value="0.9"/>
  <xacro:property name="lidar_offset_x" value="0.36"/>


  <!-- ========== Base Footprint Link ========== -->
  <link name="base_footprint"/>
    
  <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_footprint_height}" rpy="0 0 0"/>
      <!-- z = wheel_offset_z (0.15) + wheel_radius (0.1) = 0.25 -->
  </joint>

  <!-- ========== Base Link ========== -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find warrior_description)/meshes/warrior_body.stl"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find warrior_description)/meshes/warrior_body.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.125" ixy="0" ixz="0" iyy="0.125" iyz="0" izz="0.225"/>
    </inertial>
  </link>

  <!-- ========== Instantiate Swerve Modules ========== -->

  <!-- Front Plate Joint -->
  <joint name="base_to_front_plate" type="fixed">
    <parent link="base_link"/>
    <child link="front_slewing_plate_link"/>
    <origin xyz="${front_plate_offset}" rpy="0 0 0"/>
  </joint>

  <!-- Front Swerve Module -->
  <xacro:swerve_module prefix="front" initial_yaw="${front_initial_angle}"
    steer_color="cyan" drive_color="gray"/>

  <!-- Left Plate Joint -->
  <joint name="base_to_left_plate" type="fixed">
    <parent link="base_link"/>
    <child link="left_slewing_plate_link"/>
    <origin xyz="${left_plate_offset}" rpy="0 0 ${angle_offset}"/>
  </joint>

  <!-- Left Swerve Module -->
  <xacro:swerve_module prefix="left" initial_yaw="${left_initial_angle}" 
     steer_color="blue" drive_color="gray"/>

  <!-- Right Plate Joint -->
  <joint name="base_to_right_plate" type="fixed">
    <parent link="base_link"/>
    <child link="right_slewing_plate_link"/>
    <origin xyz="${right_plate_offset}" rpy="0 0 ${-angle_offset}"/>
  </joint>

  <!-- Right Swerve Module -->
  <xacro:swerve_module prefix="right" initial_yaw="${right_initial_angle}"
    steer_color="green" drive_color="gray"/>


  <!-- ========== Pole Link ========== -->
  <link name="pole_link">
    <!-- Visual/collision commented out in original -->
  </link>
  
  <joint name="base_to_pole" type="fixed">
    <parent link="base_link"/>
    <child link="pole_link"/>
    <origin xyz="0 0 ${pole_height}" rpy="3.1415 0 0"/>
  </joint>

  <!-- ========== LiDAR Link ========== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 -0.015 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find warrior_description)/meshes/unitree_lidar.stl"/>
      </geometry>
      <material name="black">
          <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.015 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find warrior_description)/meshes/unitree_lidar.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.015 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
    </inertial> 
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.32 0 0.875" rpy="3.1415 0 0"/>
  </joint>

  <!-- ========== Camera Link ========= -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 -0.027 ${camera_offset_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find warrior_description)/meshes/insta360_camera.stl"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.027 ${camera_offset_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find warrior_description)/meshes/insta360_camera.stl"/>
      </geometry>
    </collision>
    <inertial>
        <origin xyz="0 -0.027 ${camera_offset_z}" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/>
    </inertial> 
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.32 0 ${0.828 + camera_offset_z}" rpy="3.1415 0 0"/>
  </joint>

  <!-- ========== Gazebo LiDAR Sensor ========== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <update_rate>10.0</update_rate>
      <lidar>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-3.1415</min_angle>
          <max_angle>3.1415</max_angle>
        </horizontal>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <topic>/lidar</topic>
      <visualize>true</visualize>
    </sensor>
  </gazebo>


</robot>