<?xml version="1.0"?>
<robot name="test_robot">
    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="file:///home/user/ros2_ws/model.stl" scale="0.003 0.003 0.003"/>
            </geometry>
        <material name="green">
            <color rgba="0.5 0.5 0.5 1"/>
        </material>
    </visual>
    <collision>
        <geometry>
            <mesh filename="file:///home/user/ros2_ws/model.stl" scale="0.003 0.003 0.003"/>
        </geometry>
    </collision>
     <inertial>
        <origin xyz="0 0 -0.04" rpy="0 0 0"/>
        <mass value="15.0"/>
        <inertia ixx="0.125" ixy="0" ixz="0" iyy="0.125" iyz="0" izz="0.225"/>
    </inertial>
    </link>
     <link name="wheel_link">
        <visual>
            <geometry>
                <mesh filename="file:///home/user/ros2_ws/wheel.stl" scale="0.003 0.003 0.003" />
            </geometry>
        <material name="blue">
            <color rgba="0.0 0.0 1.0 1"/>
        </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file:///home/user/ros2_ws/wheel.stl" scale="0.003 0.003 0.003" />
            </geometry>
        </collision>
           <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    </link>
    <joint name="base_to_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_link"/>
        <origin xyz="2.2 0.5 0.014" rpy="0 0 -0.9"/>
        <axis xyz="0 1 0"/>
    </joint>
    <link name="wheel_link2">
        <visual>
            <geometry>
                <mesh filename="file:///home/user/ros2_ws/wheel.stl" scale="0.003 0.003 0.003"/>
            </geometry>
            <material name="green">
                <color rgba="0.0 1.0 0.0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file:///home/user/ros2_ws/wheel.stl" scale="0.003 0.003 0.003"/>
            </geometry>
        </collision>
         <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    </link>
    <joint name="base_to_wheel2" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_link2"/>
        <origin xyz="1.5 1.7 0.014" rpy="0 0 0.785"/>
        <axis xyz="0 1 0"/>
    </joint>
    <link name="wheel_link3">
        <visual>
            <geometry>
                <mesh filename="file:///home/user/ros2_ws/wheel.stl" scale="0.003 0.003 0.003"/>
            </geometry>
            <material name="red">
                <color rgba="1.0 0.0 0.0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file:///home/user/ros2_ws/wheel.stl" scale="0.003 0.003 0.003"/>
            </geometry>
        </collision>
         <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    </link>
    <joint name="base_to_wheel3" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_link3"/>
        <origin xyz="0.18 0.15 0.014" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    <link name="pole_for_lidar">
        <visual>
            <geometry>
                <cylinder length="1.56" radius="0.15"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 .8 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="1.56" radius="0.15"/>
            </geometry>
        </collision>
        <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.005"/>
    </inertial>
    </link>
    <joint name="base_to_lidar_pole" type="fixed">
        <parent link="base_link"/>
        <child link="pole_for_lidar"/>
        <origin xyz="1.5 1 0.9" rpy="0 0 0"/>
    </joint>
    <!-- LIDAR link -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder length="0.15" radius="0.16"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.25" radius="0.16"/>
            </geometry>
        </collision>
        <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
    </inertial>
    </link>
    <joint name="lidar_to_pole" type="fixed">
        <parent link="pole_for_lidar"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.8" rpy="0 0 0"/>
    </joint>
    <!-- lidar definitions for gazebo harmonic simulation -->
    <gazebo>
    <sensor type="ray" name="lidar_sensor">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>5.0</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>180</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.12</min>
                <max>5</max>
                <resolution>0.02</resolution>
            </range>
        </ray>
        <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_laser.so">
            <topicName>/scan</topicName>
            <frameName>lidar_link</frameName>
        </plugin>
    </sensor>
</gazebo>
<!-- Camera -->
</robot>