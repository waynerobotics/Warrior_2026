<sdf version='1.7'>
  <world name='default'>
    <!-- ***************************************************
          Gazebo World Coordinates
          This defines the bottom left corner of the gazebo frame.
          BOTTOM LEFT CORNER
          The coordinates are in meters.          
    *************************************************** -->
    <scene>
      <ambient>1 1 1</ambient>
      <grid>false</grid>
    </scene>

    <frame name='igvc_frame'>
      <pose relative_to='world'>-2.5 17.2 0 0 0 3.1415</pose>
    </frame>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>42.66791</latitude_deg>
      <longitude_deg>-83.21958</longitude_deg>
      <elevation>286</elevation>
      <heading_deg>90</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="ODE">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin> -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
      <name>Ground Plane</name>
      <pose relative_to='igvc_frame'>0 0 0 0 0 0</pose>
    </include>

    <!-- Stop Sign -->
    <include>
      <uri>model://stop_sign</uri>
