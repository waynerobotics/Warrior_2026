<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <world name="igvc2027_autonav">
    <!-- Generated from the versioned shared IGVC course definition. Synthetic 2027 training layout; geographic anchor is not surveyed waypoints. -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.58 0.63</ambient_light>
        <background_color>0.66 0.78 0.9</background_color>
        <camera_pose>83.2395601 -28.3573719 55 0 0.703667838 2.30361143</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui>
          <title>Entity context menu</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
