material competition/track
{
    technique
    {
        pass
        {
            ambient 0.5 0.5 0.5 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.0 0.0 0.0 1.0

            texture_unit
            {
                texture track.png
                tex_coord_set 0
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}