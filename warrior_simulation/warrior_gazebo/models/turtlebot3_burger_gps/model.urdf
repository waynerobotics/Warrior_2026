<?xml version="1.0" ?>
<robot name="turtlebot3_burger">

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.064 0 0.070" rpy="0 0 0"/>
      <mass value="0.8257350"/>
      <inertia ixx="0.0195270" ixy="0" ixz="0" iyy="0.0195270" iyz="0" izz="0.0195270"/>
    </inertial>

    <collision name="base_collision">
      <origin xyz="-0.032 0 0.070" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.14"/>
      </geometry>
    </collision>

    <visual name="base_visual">
      <origin xyz="-0.032 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://turtlebot3_common/meshes/bases/burger_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="base_material">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
  </link>

  <link name="imu_link">
  </link>

  <link name="base_scan">
    <inertial>
      <origin xyz="-0.020 0 0.161" rpy="0 0 0"/>
      <mass value="0.114"/>
      <inertia ixx="0.0001" ixy="0.000" ixz="0.000" iyy="0.0001" iyz="0.000" izz="0.0001"/>
    </inertial>

    <collision name="lidar_sensor_collision">
      <origin xyz="-0.020 0 0.161" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0508" length="0.055"/>
      </geometry>
    </collision>

    <visual name="lidar_sensor_visual">
      <origin xyz="-0.032 0 0.171" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://turtlebot3_common/meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="lidar_material">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <link name="wheel_left_link">
    <inertial>
      <origin xyz="0 0.08 0.023" rpy="-1.57 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0000544" ixy="0" ixz="0" iyy="0.0000544" iyz="0" izz="0.0001089"/>
    </inertial>

    <collision name="wheel_left_collision">
      <origin xyz="0 0.08 0.023" rpy="-1.57 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <surface>
        <friction>
          <ode mu="100000.0" mu2="100000.0"/>
        </friction>
        <contact>
          <ode soft_cfm="0" soft_erp="0.2" kp="1e+5" kd="1" max_vel="0.01" min_depth="0.001"/>
        </contact>
      </surface>
    </collision>

    <visual name="wheel_left_visual">
      <origin xyz="0 0.08 0.023" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://turtlebot3_common/meshes/wheels/left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <link name="wheel_right_link">
    <inertial>
      <origin xyz="0.0 -0.08 0.023" rpy="-1.57 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0000544" ixy="0" ixz="0" iyy="0.0000544" iyz="0" izz="0.0001089"/>
    </inertial>

    <collision name="wheel_right_collision">
      <origin xyz="0.0 -0.08 0.023" rpy="-1.57 0 0"/>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <surface>
        <friction>
          <ode mu="100000.0" mu2="100000.0"/>
        </friction>
        <contact>
          <ode soft_cfm="0" soft_erp="0.2" kp="1e+5" kd="1" max_vel="0.01" min_depth="0.001"/>
        </contact>
      </surface>
    </collision>

    <visual name="wheel_right_visual">
      <origin xyz="0.0 -0.08 0.023" rpy="0 0 0"/>
      <geometry>
        <mesh filename="model://turtlebot3_common/meshes/wheels/right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="wheel_material">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <link name="caster_back_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.00001" ixy="0.000" ixz="0.000" iyy="0.00001" iyz="0.000" izz="0.00001"/>
    </inertial>

    <collision name="caster_back_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <surface>
        <contact>
          <ode soft_cfm="0" soft_erp="0.2" kp="1e+5" kd="1" max_vel="0.01" min_depth="0.001"/>
        </contact>
      </surface>
    </collision>
  </link>

  <link name="gps_link">
  </link>

  <!-- Joints -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
  </joint>

  <joint name="wheel_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.08 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20" velocity="10" lower="0" upper="0"/>
  </joint>

  <joint name="wheel_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.08 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20" velocity="10" lower="0" upper="0"/>
  </joint>

  <joint name="caster_back_joint" type="ball">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.081 0 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.032 0 0.068" rpy="0 0 0"/>
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.032 0 0.171" rpy="0 0 0"/>
  </joint>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.05 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo plugins for sensors and actuators -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Sensor plugins in Gazebo-specific format -->
  <gazebo reference="imu_link">
    <sensor name="tb3_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>imu</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="base_scan">
    <sensor name="hls_lfcd_lds" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>5</update_rate>
      <topic>scan</topic>
      <gz_frame_id>base_scan</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120000</min>
          <max>3.5</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <always_on>true</always_on>
      <update_rate>1</update_rate>
      <topic>gps/fix</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <navsat>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

</robot>
