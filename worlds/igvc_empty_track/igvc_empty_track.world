<?xml version="1.0"?>
<sdf version="1.9">
	<world name="igvc_empty_track_world">
		<!-- Physics: ODE engine with defaults -->
		<physics name="ode_physics" default="true" type="ode">
			<!-- time step and max step controls -->
			<max_step_size>0.001</max_step_size>
			<real_time_update_rate>1000</real_time_update_rate>
			<!-- standard gravity along -Z -->
			<gravity>0 0 -9.81</gravity>
			<!-- solver params (default-ish) -->
			<ode>
				<solver>
					<type>quick</type>
					<iters>50</iters>
					<sor>1.3</sor>
				</solver>
				<constraints>
					<cfm>0.0</cfm>
					<erp>0.2</erp>
					<contact_max_correcting_vel>100.0</contact_max_correcting_vel>
					<contact_surface_layer>0.001</contact_surface_layer>
				</constraints>
			</ode>
		</physics>

		<!-- Ambient and directional light (sun) -->
		<scene>
			<ambient>0.4 0.4 0.4 1</ambient>
			<background>0.7 0.8 1 1</background>
		</scene>

		<sun>
			<pose>0 0 100 0 0 0</pose>
			<diffuse>1 1 0.9 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
			</attenuation>
		</sun>

		<!-- A finite ground represented by a thin static box to emulate a 500ft x 120ft plane -->
		<!-- 500 ft = 152.4 m ; 120 ft = 36.576 m -->
		<model name="finite_ground">
			<static>true</static>
			<pose>0 0 0 0 0 0</pose>

			<link name="ground_link">
				<!-- Visual: simple concrete-like color -->
				<visual name="ground_visual">
					<geometry>
						<box>
							<size>152.4 36.576 0.2</size>
						</box>
					</geometry>
				</visual>

				<!-- Collision: matches the visual geometry -->
				<collision name="ground_collision">
					<geometry>
						<box>
							<size>152.4 36.576 0.2</size>
						</box>
					</geometry>
					<surface>
						<friction>
							<ode>
								<mu>1.0</mu>
								<mu2>1.0</mu2>
							</ode>
						</friction>
						<contact>
							<ode>
								<soft_cfm>0.0</soft_cfm>
								<soft_erp>0.2</soft_erp>
							</ode>
						</contact>
					</surface>
				</collision>

				<!-- Give the ground a tiny inertial so physics sees it, but keep it static -->
				<inertial>
					<mass>1.0</mass>
					<inertia>
						<ixx>0.01</ixx>
						<iyy>0.01</iyy>
						<izz>0.01</izz>
					</inertia>
				</inertial>
			</link>
		</model>

		<!-- Optional boundary walls to keep things on the track -->
		<model name="boundary_walls">
			<static>true</static>
			<pose>0 0 0 0 0 0</pose>

			<!-- Long wall along +Y side -->
			<link name="wall_north">
				<pose>0 18.288 1 0 0 0</pose> <!-- half of 36.576 is 18.288 -->
				<visual name="wall_north_visual">
					<geometry>
						<box>
							<size>152.4 0.2 2</size>
						</box>
					</geometry>
					<material>
						<ambient>0.6 0.6 0.6 1</ambient>
						<diffuse>0.7 0.7 0.7 1</diffuse>
					</material>
				</visual>
				<collision name="wall_north_collision">
					<geometry>
						<box>
							<size>152.4 0.2 2</size>
						</box>
					</geometry>
				</collision>
			</link>

			<!-- Long wall along -Y side -->
			<link name="wall_south">
				<pose>0 -18.288 1 0 0 0</pose>
				<visual name="wall_south_visual">
					<geometry>
						<box>
							<size>152.4 0.2 2</size>
						</box>
					</geometry>
				</visual>
				<collision name="wall_south_collision">
					<geometry>
						<box>
							<size>152.4 0.2 2</size>
						</box>
					</geometry>
				</collision>
			</link>

			<!-- Short walls at ends along X to close the rectangle -->
			<link name="wall_east">
				<pose>76.2 0 1 0 0 0</pose> <!-- half of 152.4 is 76.2 -->
				<visual name="wall_east_visual">
					<geometry>
						<box>
							<size>0.2 36.576 2</size>
						</box>
					</geometry>
				</visual>
				<collision name="wall_east_collision">
					<geometry>
						<box>
							<size>0.2 36.576 2</size>
						</box>
					</geometry>
				</collision>
			</link>

			<link name="wall_west">
				<pose>-76.2 0 1 0 0 0</pose>
				<visual name="wall_west_visual">
					<geometry>
						<box>
							<size>0.2 36.576 2</size>
						</box>
					</geometry>
				</visual>
				<collision name="wall_west_collision">
					<geometry>
						<box>
							<size>0.2 36.576 2</size>
						</box>
					</geometry>
				</collision>
			</link>
		</model>

		<!-- GUI settings: camera position -->
		<gui fullscreen="0">
			<camera name="user_camera">
				<pose> -40 0 20 0 0 1.57</pose>
			</camera>
		</gui>

	</world>
</sdf>
